{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "stg",
            "prd"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Never",
            "Always"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "credentials": {
      "type": "object",
      "required": [
        "adminToken",
        "readerToken"
      ],
      "properties": {
        "adminToken": {
          "type": "string",
          "minLength": 1
        },
        "readerToken": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

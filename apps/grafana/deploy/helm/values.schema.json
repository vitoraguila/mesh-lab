{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
    "global": {"type": "object", "properties": {"environment": {"enum": ["stg", "prd"]}}},
    "image": {"type": "object", "properties": {"tag": {"type": "string", "minLength": 1}, "pullPolicy": {"enum": ["IfNotPresent", "Never", "Always"]}}},
    "service": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "datasource": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "stg",
            "prd"
          ]
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "prefix",
          "delegate"
        ],
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    }
  }
}
